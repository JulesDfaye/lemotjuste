{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-mot-juste",
  "compatibility_date": "2026-11-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Le Worker ne traite que /api/* ; le reste est servi directement par Cloudflare
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // Remplacez database_id par l'identifiant donné par : npx wrangler d1 create le-mot-juste-db
    { "binding": "DB", "database_name": "le-mot-juste-db", "database_id": "REMPLACEZ_PAR_VOTRE_ID" }
  ],
  // Adresse e-mail de l'administrateur (non secrète). Le mot de passe, lui, est un secret Cloudflare.
  "vars": { "ADMIN_EMAIL": "sdftechnologie@gmail.com" },
  "observability": { "enabled": true }
  // Domaine personnalisé : "routes": [{ "pattern": "lemotjuste.votredomaine.com", "custom_domain": true }]
}
